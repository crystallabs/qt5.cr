require "ini"

LOCK_FILE = "qt5.lock"
min_version = "5.0.0"

ENV["QT_SELECT"] = "5"

# The platform part of a binding name, "{os}-{libc}-{architecture}", with the
# values of bindgen's `Variables.builtin` that `decide_binding_slow.cr` uses.
HOST_OS   = {% if flag?(:darwin) %} "darwin" {% elsif flag?(:freebsd) %} "freebsd" {% elsif flag?(:linux) %} "linux" {% elsif flag?(:openbsd) %} "openbsd" {% elsif flag?(:unix) %} "unix" {% elsif flag?(:windows) %} "windows" {% else %} "unknown" {% end %}
HOST_LIBC = {% if flag?(:gnu) %} "gnu" {% elsif flag?(:musl) %} "musl" {% else %} "unknown" {% end %}
HOST_ARCH = {% if flag?(:aarch64) %} "aarch64" {% elsif flag?(:arm) %} "arm" {% elsif flag?(:armhf) %} "armhf" {% elsif flag?(:i686) %} "i686" {% elsif flag?(:x86_64) %} "x86_64" {% else %} "unknown" {% end %}

HOST_PLATFORM = "#{HOST_OS}-#{HOST_LIBC}-#{HOST_ARCH}"

BINDING_DIR = File.expand_path("../src/qt5/binding", __DIR__)
EXT_DIR     = File.expand_path("../ext", __DIR__)

# Finds qmake like `config/find_paths.yml` does: `QMAKE`, then `qmake-qt5`,
# then `qmake` (which picks Qt5 through `QT_SELECT` with qtchooser).
def find_qmake : String?
  if qmake = ENV["QMAKE"]?.presence
    return qmake
  end

  Process.find_executable("qmake-qt5") || Process.find_executable("qmake")
end

# Asks qmake for a Qt property, nil if that fails.
def qmake_query(qmake : String, property : String) : String?
  output = IO::Memory.new
  status = Process.run(qmake, ["-query", property], output: output, error: Process::Redirect::Close)
  output.to_s.strip.presence if status.success?
rescue IO::Error | File::Error
  nil
end

def version_parts(version : String) : Array(Int32)
  version.split('.').map { |part| part.to_i? || 0 }
end

# Returns the Qt version and binding name, nil if qmake can't be found or isn't
# Qt5 of at least *min_version*.
def detect_with_qmake(min_version : String) : {String, String}?
  qmake = find_qmake
  return if qmake.nil?

  qt_version = qmake_query(qmake, "QT_VERSION")
  return if qt_version.nil?

  unless qt_version.starts_with?("5.")
    STDERR.puts "#{qmake} is Qt #{qt_version}, not Qt5"
    return
  end
  return if (version_parts(qt_version) <=> version_parts(min_version)) < 0

  # Remove patch version: "5.9.2" -> "5.9"
  detected_version = qt_version.split('.')[0..1].join('.')
  {detected_version, "#{HOST_PLATFORM}-qt#{detected_version}"}
end

# Builds the binding's static library with qmake's include directory.  Returns
# nil if qmake can't be asked, else whether make succeeded.
def make_with_qmake(chosen_binding : String) : Bool?
  qmake = find_qmake
  return if qmake.nil?

  include_dir = qmake_query(qmake, "QT_INSTALL_HEADERS/get")
  return if include_dir.nil?

  status = Process.run(
    "make",
    env: {
      "BINDING_PLATFORM" => chosen_binding,
      "QT_INCLUDE_DIR"   => include_dir,
      "QT_LIBS_DIR"      => qmake_query(qmake, "QT_INSTALL_LIBS") || "",
    },
    output: STDERR,
    error: STDERR,
    chdir: EXT_DIR,
  )

  status.success?
end

# 0. Is there a binding override?
if File.exists?("#{BINDING_DIR}/binding_.cr")
  puts "" # Yes, there is.  Use it!
  exit 0
end

# 1. Find project root
project_root = nil
lib_path = File.expand_path("../../../", __DIR__)
if Dir.exists?(lib_path) && File.basename(lib_path) == "lib" && Dir.exists?("#{lib_path}/qt5.cr")
  project_root = File.expand_path("..", lib_path)
else
  project_root = File.expand_path("..", __DIR__)
end

# 2. Check for the lock file
lock_file_path = "#{project_root}/#{LOCK_FILE}"
if File.exists?(lock_file_path)
  lock_file = INI.parse(File.read(lock_file_path))
  section = lock_file[""]

  min_version = section["min_version"]? || min_version
  chosen_binding = section["binding"]?
end

if chosen_binding.nil?
  # 3. A single binding for this platform, e.g. one generated by hand?
  bindings = Dir.children(BINDING_DIR).select { |name| name.starts_with?("binding_") && name.ends_with?(".cr") }
  if bindings.size == 1
    only = bindings.first.lchop("binding_").rchop(".cr")
    if only.starts_with?("#{HOST_PLATFORM}-qt")
      detected = {only[/-qt([0-9.]+)$/, 1]? || min_version, only}
    end
  end

  # 4. Ask qmake, and only if that fails, bindgen's path finding.
  detected ||= detect_with_qmake(min_version)

  if detected.nil?
    Dir.cd(project_root) do
      output = `crystal run '#{__DIR__}/decide_binding_slow.cr' -- #{min_version.inspect}`.strip

      unless $?.success?
        puts output
        raise "Support script decide_binding_slow.cr failed"
      end

      version, binding = output.split(' ') # Destructure
      detected = {version, binding}
    end
  end

  raise "This shouldn't happen." if detected.nil?
  min_version, chosen_binding = detected

  STDERR.puts "Using Qt #{min_version} through #{chosen_binding}"
  STDERR.puts "This will be saved in #{lock_file_path}"

  File.open(lock_file_path, "w") do |h|
    h.puts <<-EOF
    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; ATTENTION ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    ; This file configures which Qt5 version your program uses.
    ;
    ; IMPORTANT: If you change this file then clear your crystal cache!
    ;            On Linux: $ rm -r ~/.cache/crystal
    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

    ; What is the minimum Qt5 version you want to use?  This is only used if
    ; no "binding" (Below) is set.
    min_version = #{min_version}

    ; Don't check-in the following lines into your repository!
    ; Generated on #{Time.local}
    binding     = #{chosen_binding}
    EOF
  end
end

# Build static library on first use.
unless File.exists?("#{EXT_DIR}/binding_#{chosen_binding}.a")
  chosen_version = chosen_binding[/-qt([0-9.]+)$/, 1]

  STDERR.puts "Couldn't find built version of #{chosen_binding} for Qt#{chosen_version}"
  STDERR.puts "Building now!"

  built = make_with_qmake(chosen_binding)
  abort "Building #{EXT_DIR}/binding_#{chosen_binding}.a failed, see above." if built == false

  if built.nil?
    # Calls out into the slow script to set up the build environment.
    Process.run(
      "crystal",
      [
        "run", "#{__DIR__}/decide_binding_slow.cr",
        "--",
        min_version, "make",
      ],
      env: {"QT_VERSION" => chosen_version},
      output: STDERR,
      error: STDERR,
    )
  end
end

puts chosen_binding
